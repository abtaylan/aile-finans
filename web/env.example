NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sunucu-taraflı, GİZLİ — asla NEXT_PUBLIC_ öneki almaz, tarayıcıya gönderilmez.
# Supabase Dashboard > Project Settings > API > service_role secret key.
# Kullanım: aile içi yönetim (üye çıkarma) — bkz. src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Şifre sıfırlama e-postasındaki bağlantının döneceği mutlak adres.
# Yerelde varsayılan (localhost:3000) yeterli. Prod'da (Vercel) bu değer
# https://aile-finans-mu.vercel.app olarak ayarlanmalı — bkz. src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
