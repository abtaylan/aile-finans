NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sunucu-taraflı, GİZLİ — asla NEXT_PUBLIC_ öneki almaz, tarayıcıya gönderilmez.
# Supabase Dashboard > Project Settings > API > service_role secret key.
# Şu anki tek kullanım amacı: test hesabı OTP kısayolu (bkz. src/app/giris/actions.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test hesabı OTP kısayolu (opsiyonel, verilmezse varsayılanlar kullanılır).
# Bu e-posta ile giriş denendiğinde gerçek e-posta gönderilmez;
# TEST_OTP_CODE değeri girildiğinde admin API ile gerçek bir oturum kurulur.
TEST_OTP_EMAIL=test@ailefinans.app
TEST_OTP_CODE=123456
